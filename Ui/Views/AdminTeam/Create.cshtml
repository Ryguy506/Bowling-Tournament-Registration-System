@model Bowling_Tournament_Registration_System.Ui.ViewModels.CreateTeamVm

<div class="container mt-4 max" >
    <h2 class="mb-4">Create Team</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="TeamName" class="form-label"></label>
            <input asp-for="TeamName" class="form-control" />
            <span asp-validation-for="TeamName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DivisionId" class="form-label">Division</label>
            <select asp-for="DivisionId" class="form-select">
                
                <option value="">-- Select Division --</option>
                @foreach (var div in Model.Divisions)
                {
                   <option value="@div.Id">@div.Name</option>
                }

            </select>
            <span asp-validation-for="DivisionId" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" asp-controller="AdminTeam" class="btn btn-secondary">Back to Teams</a>
        <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>

    
</div>